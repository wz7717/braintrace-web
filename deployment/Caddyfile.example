# Future deployment only. No login. Do not commit a filled Caddyfile.
# Start Python with --public-origin https://the-same-host --trust-proxy-client-ip
# The local proxy must overwrite this header; never forward a client-supplied value.
{$BRAINTRACE_DEMO_HOST} {
    reverse_proxy 127.0.0.1:8766 {
        header_up X-BrainTrace-Client-IP {remote_host}
    }
}
